<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>BindInContainer</AssemblyName>
        <RootNamespace>BindInContainer</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <Version>1.0.0</Version>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    </PropertyGroup>

    <PropertyGroup>
        <GameDir Condition=" '$(GameDir)' == '' ">C:\SPT</GameDir>
        <Managed>$(GameDir)\EscapeFromTarkov_Data\Managed</Managed>
        <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
        <SptPlugins>$(GameDir)\BepInEx\plugins\spt</SptPlugins>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Plugin.cs" />
        <Compile Include="ContainerBinding.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp" HintPath="$(Managed)\Assembly-CSharp.dll" Private="false" />
        <Reference Include="ItemComponent.Types" HintPath="$(Managed)\ItemComponent.Types.dll" Private="false" />
        <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
        <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
        <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" Private="false" />
        <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" Private="false" />
        <Reference Include="spt-reflection" HintPath="$(SptPlugins)\spt-reflection.dll" Private="false" />
    </ItemGroup>

    <Target Name="DeployToGame" AfterTargets="AfterBuild">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" ContinueOnError="true" />
    </Target>
</Project>
